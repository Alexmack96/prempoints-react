<!--
  Settings shared by every project under api-dotnet/ (Api, AppHost,
  ServiceDefaults and both test projects), so none of them restates the target
  framework or nullability.
-->
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
