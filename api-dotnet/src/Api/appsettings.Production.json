{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // The live database. Same server and same credential as every other
  // environment — only the Initial Catalog differs, and it is swapped in from
  // here. See GetPremPointsConnectionString in ServiceCollectionExtensions.
  "Database": {
    "Name": "PremPointsProd"
  },
  // Holds the database awake across the weekend, when the league is played, and
  // lets it pause Monday to Thursday. Editing a window here is a config change
  // rather than a code one, so widening it around a midweek fixture is cheap.
  //
  // Compute is billed while the database is awake, so the hours below are the
  // bill. See DatabaseKeepAliveOptions before widening them.
  "DatabaseKeepAlive": {
    "Enabled": true,
    "TimeZone": "Europe/London",
    "MinimumMinutesBetweenProbes": 30,
    "Windows": [
      {
        "Days": [ "Friday", "Saturday", "Sunday" ],
        "Start": "06:00",
        "End": "22:00"
      }
    ]
  },
  "WorkOS": {
    "ClientId": "client_01KBQJ6BQ4MMNZ575FAP3CBK0M",
    "DiscoveryEndpoint": ""
  }
}
