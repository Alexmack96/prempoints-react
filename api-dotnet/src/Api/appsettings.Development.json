{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Local work runs against PremPointsDev on the shared Azure SQL server. Only
  // the database name changes between environments — the server and credential
  // come from ConnectionStrings:PremPoints in user-secrets, and this name is
  // swapped into its Initial Catalog. Not a secret, so it is committed.
  "Database": {
    "Name": "PremPointsDev"
  }
  // No ConnectionStrings override here: that string contains a password and
  // lives in user-secrets. See appsettings.json.
}
