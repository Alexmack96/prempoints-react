{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "ConnectionStrings": {
    // Resolved by AddConnectionString("PremPoints") in AppHost.cs and injected
    // into the API as ConnectionStrings__PremPoints.
    //
    // Safe to commit: LocalDB is machine-local and this uses Windows integrated
    // auth, so there is no secret in it. A deployment connection string belongs
    // in user-secrets (`dotnet user-secrets set "ConnectionStrings:PremPoints"
    // "..."` from this folder) so it never reaches git.
    "PremPoints": "Server=(localdb)\\MSSQLLocalDB;Database=PremPoints;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
