{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  // No ConnectionStrings section, deliberately.
  //
  // Local development targets the Azure SQL database PremPointsDev, which
  // authenticates with a SQL login, so the connection string contains a password
  // and cannot be committed. It lives in user-secrets instead:
  //
  //   dotnet user-secrets set "ConnectionStrings:PremPoints" "<string>" --project src/AppHost
  //
  // AddConnectionString("PremPoints") in AppHost.cs resolves it from there and
  // injects it into the API as ConnectionStrings__PremPoints. A missing value
  // fails at startup rather than falling back to a local database, which would
  // otherwise read and write the wrong data silently.
  //
  // The integration tests do not use this: LocalDbHarness builds its own
  // throwaway LocalDB connection string per test.
}
